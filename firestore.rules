rules_version = '2';

// Regras de segurança do Racha 10.
// Papéis de plataforma (directory/{uid}.platformRole):
//  - owner: o dono (identificado pelo e-mail abaixo); único que promove organizadores; acessa todos os grupos.
//  - organizer: cria grupos e administra os seus; adiciona atletas a partir do diretório.
//  - athlete: participa apenas dos grupos em que foi colocado.
// Dentro de um grupo: members/{uid}.role = 'manager' | 'player'.
// Não existe convite: quem monta o grupo é o organizador/dono.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['martinsphilippes@gmail.com'];
    }
    function directoryOf(userId) {
      return get(/databases/$(database)/documents/directory/$(userId)).data;
    }
    function isOrganizer() {
      return isOwner() || (signedIn() && directoryOf(uid()).platformRole in ['organizer', 'owner']);
    }
    function memberPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid());
    }
    function isMember(groupId) { return isOwner() || (signedIn() && exists(memberPath(groupId))); }
    function isManager(groupId) {
      return isOwner() || (signedIn() && exists(memberPath(groupId))
        && get(memberPath(groupId)).data.role == 'manager');
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Diretório (nome, e-mail, papel de plataforma) ----------
    match /directory/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == userId
        && request.resource.data.uid == userId
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && (request.resource.data.platformRole == 'athlete'
            || (request.resource.data.platformRole == 'owner' && isOwner()));
      // Só o dono muda papéis; cada um atualiza o próprio nome e o próprio último acesso.
      allow update: if (isOwner() && changedOnly(['platformRole'])
            && request.resource.data.platformRole in ['athlete', 'organizer', 'owner']
            && (request.resource.data.platformRole != 'owner' || userId == uid()))
        || (uid() == userId && changedOnly(['name', 'lastSeenAt']));
      // Dono remove registros do diretório (ex.: contas de teste), nunca o próprio.
      allow delete: if isOwner() && userId != uid();
    }

    // ---------- Registro de acessos (quem abriu o app e quando) ----------
    match /accessLogs/{logId} {
      allow read: if isOwner();
      // Qualquer aparelho registra a própria abertura (visitante sem conta usa uid null).
      allow create: if request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'deviceId', 'at', 'platform', 'installed', 'version', 'path'])
        && request.resource.data.at is number
        && request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 40
        && request.resource.data.path is string && request.resource.data.path.size() <= 200
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == uid()));
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- Perfil privado ----------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isOwner());
      allow create: if signedIn() && uid() == userId
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'address', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update: if signedIn() && uid() == userId && changedOnly(['name', 'phone', 'address']);
      allow delete: if false;
    }

    // ---------- Grupos ----------
    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create: if isOrganizer() && request.resource.data.createdBy == uid()
        && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update: if isManager(groupId) && changedOnly([
        'name', 'sport', 'minPlayers', 'notes', 'defaultVenueId', 'defaultCourtId',
        'weekday', 'startTime', 'durationMinutes',
        'pixKeyType', 'pixKey', 'pixName', 'pixCity'
      ]);
      allow delete: if isOwner();

      // ---------- Membros ----------
      match /members/{memberId} {
        allow read: if isMember(groupId);
        // (a) criador do grupo (organizador) vira gestor no mesmo lote da criação;
        // (b) gestor/dono adiciona um atleta do diretório;
        // (c) dono adiciona um organizador como gestor do grupo.
        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && request.resource.data.groupId == groupId
          && (
            (memberId == uid() && request.resource.data.role == 'manager' && isOrganizer()
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == uid())
            ||
            (request.resource.data.role == 'player' && isManager(groupId))
            ||
            (request.resource.data.role == 'manager' && isOwner()
              && directoryOf(memberId).platformRole in ['organizer', 'owner'])
          );
        // Dono define quem é gestor (apenas organizadores); membro atualiza o próprio nome.
        allow update: if (isOwner() && changedOnly(['role'])
              && (request.resource.data.role == 'player'
                  || directoryOf(memberId).platformRole in ['organizer', 'owner']))
          || (memberId == uid() && changedOnly(['name']));
        // Gestor remove atletas; dono remove qualquer um; atleta pode sair.
        allow delete: if (isManager(groupId) && memberId != uid() && resource.data.role == 'player')
          || (isOwner() && memberId != uid())
          || (memberId == uid() && resource.data.role == 'player');
      }

      // ---------- Locais e quadras ----------
      match /venues/{venueId} {
        allow read: if isMember(groupId);
        allow write: if isManager(groupId);
      }
      match /courts/{courtId} {
        allow read: if isMember(groupId);
        allow write: if isManager(groupId);
      }

      // ---------- Agenda recorrente ----------
      match /schedules/{scheduleId} {
        allow read: if isMember(groupId);
        allow write: if isManager(groupId);
      }

      // ---------- Partidas ----------
      match /matches/{matchId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isManager(groupId);

        // Disponibilidade / posição / pagamento por atleta
        match /players/{playerId} {
          allow read: if isMember(groupId);
          // Atleta: cria/edita o próprio registro, sem tocar em pagamento.
          allow create: if (isMember(groupId) && playerId == uid()
              && request.resource.data.paid == false
              && request.resource.data.paidAt == null)
            || isManager(groupId);
          allow update: if (isMember(groupId) && playerId == uid()
              && changedOnly(['status', 'position', 'updatedAt', 'name']))
            || isManager(groupId);
          allow delete: if isManager(groupId);
        }
      }

      // ---------- Comunicados ----------
      match /announcements/{announcementId} {
        allow read: if isMember(groupId);
        allow create: if isManager(groupId) && request.resource.data.createdBy == uid();
        allow update, delete: if isManager(groupId);
      }
    }

    // Consulta em grupo de coleção: "de quais grupos eu participo?"
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == uid();
    }
  }
}
